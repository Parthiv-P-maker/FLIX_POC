# Copy to .env and change JWT_SECRET before running.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/flixdrive

# Any long random string. Rotating it invalidates every issued token.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Only needed if the client is served from a different origin than the API.
CLIENT_ORIGIN=http://localhost:5173

MAX_UPLOAD_MB=2048
MAX_PHOTO_MB=25

# Where uploads, photos and posters are written. Defaults to ./storage.
# Point this at a different disk if the media outgrows the project directory.
# STORAGE_ROOT=/var/lib/flixdrive

# Set to 1 when hosted behind a proxy (Render, Railway, Fly, nginx). Leave it
# unset when running locally - see the comment in src/server.js.
# TRUST_PROXY=1

# Photo tagging and smart search (services/imageTagger.js). The CLIP model is
# downloaded from the Hugging Face hub on first run (~150 MB) and cached.
# Set ML_ENABLED=false to turn it off; search then falls back to titles.
# ML_ENABLED=true
# ML_MODEL=Xenova/clip-vit-base-patch32
# ML_DTYPE=q8
# MODEL_CACHE_DIR=./.model-cache

# Auth throttling, per IP. Login is per 15 minutes, register is per hour.
# Loose enough that a forgetful human is never locked out, far too tight to
# brute-force through. Raise them if a demo needs to hammer the API.
RATE_LIMIT_LOGIN=20
RATE_LIMIT_REGISTER=15
