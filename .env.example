# Copy to .env and change JWT_SECRET before running.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/flixdrive

# Any long random string. Rotating it invalidates every issued token.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Only needed if the client is served from a different origin than the API.
CLIENT_ORIGIN=http://localhost:5173

MAX_UPLOAD_MB=2048
MAX_PHOTO_MB=25

# Auth throttling, per IP. Login is per 15 minutes, register is per hour.
# Loose enough that a forgetful human is never locked out, far too tight to
# brute-force through. Raise them if a demo needs to hammer the API.
RATE_LIMIT_LOGIN=20
RATE_LIMIT_REGISTER=15
